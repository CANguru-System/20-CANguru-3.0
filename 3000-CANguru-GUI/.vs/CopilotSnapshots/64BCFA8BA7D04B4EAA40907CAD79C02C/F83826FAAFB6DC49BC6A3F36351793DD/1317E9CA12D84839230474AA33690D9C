using System;
using System.Diagnostics;
using System.Windows.Forms;

namespace CANguru.GUI.DecoderSettings
{
    public partial class frmDecoderSettings : Form
    {
        private readonly Control settingsPanel;

        public frmDecoderSettings(Control settingsPanel)
        {
            InitializeComponent();

            this.settingsPanel = settingsPanel;

            // Panel einfügen
            settingsPanel.Dock = DockStyle.Top;
            settingsPanel.AutoSize = false;                   // WICHTIG

            panelContainer.Controls.Add(settingsPanel);

            Debug.WriteLine("Panel PreferredSize: " + settingsPanel.PreferredSize);
            Debug.WriteLine("Panel Size: " + settingsPanel.Size);
            Debug.WriteLine("Panel MinimumSize: " + settingsPanel.MinimumSize);
            Debug.WriteLine("Container PreferredSize: " + panelContainer.PreferredSize);
            Debug.WriteLine("Container Size: " + panelContainer.Size);

            // Buttons
            btnSave.Click += (s, e) =>
            {
                if (settingsPanel is DecoderSettingsPanelBase basePanel)
                    basePanel.SaveToDecoder();

                this.DialogResult = DialogResult.OK;
                Close();
            };

            btnCancel.Click += (s, e) =>
            {
                this.DialogResult = DialogResult.Cancel;
                Close();
            };

            // Daten laden
            if (settingsPanel is DecoderSettingsPanelBase basePanel2)
                basePanel2.LoadFromDecoder();
        }
    }
}
